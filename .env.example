# Copy to .env (never commit .env). Secrets live in Secret Manager in the cloud.
DRISHTI_ENV=local
DATABASE_URL=sqlite:///./drishti.sqlite            # cloud: postgresql+psycopg://user:pass@host/db
SESSION_DB_URL=sqlite+aiosqlite:///./sessions.sqlite   # cloud: postgresql+asyncpg://...
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BACKEND=hash                              # hash (offline) | vertex
TRACE_EXPORTER=console                              # console | otlp | gcp
API_KEY_PEPPER=change-me                            # set via Secret Manager in cloud
